# AI 修正与翻译使用兼容 OpenAI Responses API 的服务。
# OpenAI：复制本文件为 .env，至少填写 AI_API_KEY。
# 本地服务：把 AI_BASE_URL 改成本地服务的 /v1 地址；如果无需密钥可留空。
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini
# 可选：留空沿用 AI_MODEL；填写后只用于每五分钟整体整理。
AI_REVIEW_MODEL=
# 可选：用于课堂总结与批量全局改写，留空则依次沿用整理模型、实时模型。
AI_SUMMARY_MODEL=

# 通常无需修改。这里必须指向完整的 Qwen3-ASR-1.7B 模型目录。
QWEN_ASR_MODEL_PATH=./models/Qwen3-ASR-1.7B-MLX-bf16

# 可选：通过局域网或反向代理访问录音页时，填写受信任网页来源，多个用逗号分隔。
# 须包含协议、域名和非默认端口，例如 https://asr.example.com；不支持通配符。
# 本机 localhost / 127.0.0.1 / [::1] 的同源页面默认允许，无需填写。
QWEN_ASR_ALLOWED_ORIGINS=

# 同一接口地址与凭证的全部 AI 功能合计并发（1–32，默认 4）。
QWEN_ASR_AI_TOTAL_CONCURRENCY=4
