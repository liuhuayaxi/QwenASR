{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharingnotes.invalid/contract/delete-note.schema.json",
  "title": "Sharing Notes delete-note (planned API v1)",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "operation": {
      "const": "delete_note"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "expectedVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$",
      "description": "Use a fresh ID for a new delete and the same ID when retrying it."
    }
  },
  "required": [
    "contractVersion",
    "operation",
    "id",
    "expectedVersion"
  ],
  "additionalProperties": false
}
