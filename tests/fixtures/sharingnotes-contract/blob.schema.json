{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharingnotes.invalid/contract/blob.schema.json",
  "title": "Sharing Notes blob (planned API v1)",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "enum": [
        "note",
        "image",
        "page",
        "pdf",
        "manifest"
      ]
    },
    "contentType": {
      "enum": [
        "application/json",
        "image/png",
        "image/webp",
        "application/pdf"
      ]
    },
    "size": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "contractVersion",
    "sha256",
    "kind",
    "contentType",
    "size"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "enum": [
              "note",
              "manifest"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "contentType": {
            "const": "application/json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "image"
          }
        }
      },
      "then": {
        "properties": {
          "contentType": {
            "const": "image/png"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "page"
          }
        }
      },
      "then": {
        "properties": {
          "contentType": {
            "const": "image/webp"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "pdf"
          }
        }
      },
      "then": {
        "properties": {
          "contentType": {
            "const": "application/pdf"
          }
        }
      }
    }
  ]
}
