{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharingnotes.invalid/contract/publish-response.schema.json",
  "title": "Sharing Notes publish-response (planned API v1)",
  "type": "object",
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "operation": {
      "enum": [
        "upsert_note",
        "delete_note",
        "blob"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "acceptedVersion": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "accepted",
        "missing_blobs",
        "deleted",
        "conflict",
        "rejected"
      ]
    },
    "missingBlobs": {
      "type": "array",
      "items": {
        "$ref": "blob.schema.json"
      }
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "contractVersion",
    "operation",
    "acceptedVersion",
    "status",
    "missingBlobs"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "missing_blobs"
          }
        }
      },
      "then": {
        "properties": {
          "acceptedVersion": {
            "type": "null"
          },
          "missingBlobs": {
            "type": "array",
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "missingBlobs": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          },
          "operation": {
            "const": "upsert_note"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "acceptedVersion": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "conflict",
              "rejected"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ],
        "properties": {
          "error": {"type": "string"},
          "acceptedVersion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "deleted"
          }
        }
      },
      "then": {
        "required": [
          "id"
        ],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"},
          "operation": {
            "const": "delete_note"
          },
          "acceptedVersion": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {"properties": {"operation": {"enum": ["upsert_note", "delete_note"]}}},
      "then": {
        "required": ["id"],
        "properties": {"id": {"$ref": "common.schema.json#/$defs/id"}}
      }
    },
    {
      "if": {"properties": {"status": {"enum": ["accepted", "missing_blobs"]}}},
      "then": {"properties": {"operation": {"enum": ["upsert_note", "blob"]}}}
    },
    {
      "if": {"properties": {"operation": {"const": "blob"}}},
      "then": {"properties": {"acceptedVersion": {"type": "null"}}}
    }
  ]
}
