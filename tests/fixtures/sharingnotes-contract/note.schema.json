{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sharingnotes.invalid/contract/note.schema.json",
  "title": "Sharing Notes note (current snapshot)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-f0-9]{20}$"
    },
    "course": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "chapter": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string"
    },
    "abstract": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "wordCount": {
      "type": "integer",
      "minimum": 0
    },
    "imageCount": {
      "type": "integer",
      "minimum": 0
    },
    "chapter_sections": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "markdown": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "start": {
            "type": "number",
            "minimum": 0
          },
          "end": {
            "type": "number",
            "minimum": 0
          },
          "corrected": {
            "type": "boolean"
          },
          "cipher": {
            "type": "string",
            "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "corrected",
          "cipher"
        ],
        "additionalProperties": true
      }
    },
    "sourceBodySha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "pattern": "^data/images/[a-f0-9]{64}\\.png$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "alt": {
            "type": "string"
          },
          "caption": {
            "type": "string"
          }
        },
        "required": [
          "src",
          "sha256",
          "width",
          "height"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "id",
    "course",
    "title",
    "chapter",
    "chapters",
    "date",
    "abstract",
    "version",
    "wordCount",
    "imageCount",
    "markdown",
    "sources",
    "sourceBodySha256",
    "images"
  ],
  "additionalProperties": true
}
